{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commsfail/template_name/v1",
  "title": "template_name output",
  "description": "Replace with yours: what each field means and how it is computed. Change the $id when the format changes.",
  "type": "object",
  "required": ["findings", "counts"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "description": "one row for each post the method points at",
      "items": {
        "type": "object",
        "required": ["seq", "who", "label", "excerpt", "why"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 0, "description": "the post"},
          "who": {"type": "string", "description": "the seat that wrote it"},
          "label": {"type": "string"},
          "excerpt": {"type": "string", "description": "redacted"},
          "why": {"type": "string", "description": "the sentence a reader would write in the margin"}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["posts", "questions", "open"],
      "additionalProperties": false,
      "properties": {
        "posts": {"type": "integer", "minimum": 0},
        "questions": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0}
      }
    }
  }
}
